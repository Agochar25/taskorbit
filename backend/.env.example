# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://taskorbit:taskorbit@localhost:5432/taskorbit?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS: comma separated list of allowed web origins ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
GLOBAL_RATE_LIMIT_MAX=300

# --- Optional: first admin created by `npm run db:seed` ---
SEED_PASSWORD=Demo@12345
